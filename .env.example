PORT=3000
# Set a unique random secret with at least 32 characters.
JWT_EMAIL_VERIFICATION_SECRET=
PUBLIC_API_URL=http://localhost:3000
DATABASE_URL=postgresql://bandup:bandup_local@localhost:5432/bandup?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=
JWT_ISSUER=bandup-api
JWT_AUDIENCE=bandup-web

# Only used when starting PostgreSQL with Docker Compose.
POSTGRES_USER=bandup
POSTGRES_PASSWORD=bandup_local
POSTGRES_DB=bandup
POSTGRES_PORT=5432

# Gmail SMTP: use an App Password, not your Google account password.
SMTP_USER=
SMTP_PASS=
